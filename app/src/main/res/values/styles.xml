<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style name="TransparentActivity" parent="AppTheme">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
    </style>

    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:forceDarkAllowed">true</item>
        <!--        <item name="preferenceTheme">@style/preferenceTheme</item>-->
        <item name="dragIcon">@drawable/ic_drag</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:colorPrimary">@android:color/white</item>
        <item name="android:colorControlNormal">@android:color/black</item>
        <item name="android:colorAccent">@android:color/black</item>
        <item name="backgroundColor">@android:color/white</item>
        <item name="android:selectableItemBackground">@drawable/item_bg_selector</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:dialogTheme">@style/EinkDialogTheme</item>

        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Theme for DialogFragment dialogs (ComposeDialogFragment etc.).
         values-v34 adds android:windowNoMoveAnimation so WindowManager does not animate
         the window when a wrap-content dialog changes size or is repositioned. -->
    <style name="EinkDialogTheme.Base" parent="android:ThemeOverlay.Material.Dialog" />
    <style name="EinkDialogTheme" parent="EinkDialogTheme.Base" />

    <!-- Theme for the frame-less Compose dialogs (ComposeDialogFragment and friends).
         DialogFragment.setStyle(STYLE_NO_FRAME, 0) would silently use android:Theme.Panel,
         whose legacy base theme overrides android:colorControlNormal / colorPrimary with
         near-invisible "legacy" colours, so the bordered window backgrounds lost their
         stroke once the app moved off AppCompat's app-namespaced attrs. Keep Theme.Panel's
         window behaviour but re-pin the colours the drawables read. -->
    <style name="EinkPanelDialogTheme" parent="@android:style/Theme.Panel">
        <item name="android:colorControlNormal">@android:color/black</item>
        <item name="android:colorPrimary">@android:color/white</item>
        <item name="android:colorAccent">@android:color/black</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textColorPrimary">@android:color/black</item>
    </style>

    <!-- remove preference activity background color -->
    <!--    <style name="preferenceTheme" parent="PreferenceThemeOverlay.v14">-->
    <!--        <item name="android:windowBackground">@null</item>-->
    <!--    </style>-->

    <style name="TouchAreaDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:backgroundDimAmount">0</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@style/MyAnimation.Window</item>
        <item name="android:windowBackground">@drawable/background_with_border</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- Full dialog theme, so accent must be re-pinned (defaults to Material teal). -->
        <item name="android:colorAccent">@android:color/black</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/MyButtonStyle</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/MyButtonStyle</item>
    </style>

    <style name="MyButtonStyle" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@android:color/black</item>
        <item name="android:backgroundTint">@android:color/white</item>
    </style>

    <style name="MyAnimation.Window" parent="@android:style/Animation.Activity">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>

    <style name="Theme.Einkbro.FullScreenDialog" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

</resources>
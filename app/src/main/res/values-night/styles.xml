<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <!--        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14</item>-->
        <item name="dragIcon">@drawable/ic_drag</item>
        <item name="android:textColor">@color/lightGray</item>
        <item name="android:textColorPrimary">@android:color/darker_gray</item>
        <item name="android:colorAccent">@color/lightGray</item>
        <item name="android:colorControlNormal">@color/lightGray</item>
        <item name="android:colorPrimary">@android:color/black</item>
        <item name="backgroundColor">@android:color/black</item>
        <item name="android:selectableItemBackground">@drawable/item_bg_selector</item>
        <item name="android:windowAnimationStyle">@null</item>

        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- remove preference activity background color -->
    <!--    <style name="PreferenceThemeOverlay.v14">-->
    <!--        <item name="android:windowBackground">@null</item>-->
    <!--    </style>-->

    <style name="EinkPanelDialogTheme" parent="@android:style/Theme.Panel">
        <item name="android:colorControlNormal">@color/lightGray</item>
        <item name="android:colorPrimary">@android:color/black</item>
        <item name="android:colorAccent">@color/lightGray</item>
        <item name="android:textColor">@color/lightGray</item>
        <item name="android:textColorPrimary">@android:color/darker_gray</item>
    </style>

    <style name="TouchAreaDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:backgroundDimAmount">0</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@drawable/background_with_border</item>
        <!-- Full dialog theme, so accent must be re-pinned (defaults to Material teal). -->
        <item name="android:colorAccent">@color/lightGray</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/MyButtonStyle</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/MyButtonStyle</item>
    </style>

    <style name="MyButtonStyle" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/lightGray</item>
        <item name="android:backgroundTint">@android:color/black</item>
    </style>



</resources>